{
  "name": "@estacionatec/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env --import tsx src/server.ts",
    "start": "node --env-file-if-exists=.env --import tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && node --import tsx scripts/bundle.ts",
    "test": "vitest run",
    "db:create-table": "node --env-file-if-exists=.env --import tsx scripts/createTable.ts",
    "db:seed": "node --env-file-if-exists=.env --import tsx scripts/seed.ts",
    "simulate": "node --env-file-if-exists=.env --import tsx scripts/simulate.ts"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.1161.0",
    "@aws-sdk/lib-dynamodb": "3.1161.0",
    "cors": "2.8.6",
    "express": "5.3.0",
    "serverless-http": "4.0.0"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@types/supertest": "7.2.1",
    "esbuild": "0.28.2",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
