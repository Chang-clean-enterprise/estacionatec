{
  "name": "estacionatec",
  "version": "0.1.0",
  "private": true,
  "description": "App para saber en donde hay lugares de estacionamiento disponible en los campus del Tec",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:init": "npm run db:create-table -w backend && npm run db:seed -w backend",
    "dev:backend": "npm run dev -w backend",
    "dev:frontend": "npm run dev -w frontend",
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:backend\" \"npm:dev:frontend\"",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces",
    "build": "npm run build --workspaces",
    "deploy": "bash infra/deploy.sh"
  },
  "devDependencies": {
    "concurrently": "10.0.6"
  }
}
